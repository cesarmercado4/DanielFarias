# Se copia a /etc/tusfotos.env en el servidor (ver deploy/AWS.md). No subir a GitHub con valores reales.
PORT=3000
HOST=127.0.0.1
DATA_DIR=/var/lib/tusfotos
GOOGLE_API_KEY=pegá_acá_la_clave_de_google
ADMIN_PASSWORD=elegí_una_contraseña_larga
# Un texto largo al azar. Con "openssl rand -hex 32" se genera uno.
SESSION_SECRET=pegá_acá_un_texto_al_azar
